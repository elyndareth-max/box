#!name=九号出行签到
#!desc=自动签到领 N 币 · Token 抓取
#!author=凉心, Minis
#!homepage=https://github.com/elyndareth-max/box
#!openUrl=https://github.com/elyndareth-max/box/blob/main/Loon/LPX/ninebot-checkin.lpx
#!tag=签到
#!icon=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/refs/heads/main/Icons/ninebot.png
#!system=iOS
#!loon_version=3.2.4(787)
#!date=2026-06-26 16:35:00

[General]
force-http-engine-hosts = cn-cbu-gateway.ninebot.com

[Script]
http-request ^https:\/\/cn-cbu-gateway\.ninebot\.com\/(portal|app-api)\/api\/user-sign\/ script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, requires-body=false, timeout=60, tag=九号出行 Token
http-request ^https:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/user-sign\/v2\/(status|sign) script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, requires-body=false, timeout=60, tag=九号出行 Token V2
cron "10 8 * * *" script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, timeout=180, enable=true, tag=九号出行签到 1/3
cron "11 8 * * *" script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, timeout=180, enable=true, tag=九号出行签到 2/3
cron "12 8 * * *" script-path=https://raw.githubusercontent.com/52Lxcloud/ScriptKit/main/Scripts/ninebot.js, timeout=180, enable=true, tag=九号出行签到 3/3

[MITM]
hostname = cn-cbu-gateway.ninebot.com
