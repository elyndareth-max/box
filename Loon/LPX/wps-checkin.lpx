#!name=WPS签到
#!desc=WPS Cookie 获取与每日签到插件
#!author=MaYIHEI, Minis
#!homepage=https://github.com/elyndareth-max/box
#!openUrl=https://github.com/elyndareth-max/box/blob/main/Loon/LPX/wps-checkin.lpx
#!tag=签到
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png
#!system=iOS
#!loon_version=3.2.4(787)
#!date=2026-06-26 16:16:10

[MITM]
hostname = personal-act.wps.cn

[Argument]
hot = input, null, tag=热门任务开关, desc=
trial = input, null, tag=试用任务开关, desc=
signin = input, null, tag=签到任务开关, desc=
fragment = input, null, tag=碎片任务开关, desc=
lottery = input, null, tag=抽奖任务开关, desc=
clockin = input, null, tag=打卡任务开关, desc=

[Script]
http-request ^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png, timeout=60, tag=WPS Cookie
cron "0 10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png, timeout=60, enable=true, tag=WPS签到, argument=hot={hot}&trial={trial}&signin={signin}&fragment={fragment}&lottery={lottery}&clockin={clockin}
