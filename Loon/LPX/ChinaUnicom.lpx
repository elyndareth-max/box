[Script]
http-request ^https:\/\/m\.client\.10010\.com\/.*(?:smartwisdomCommon|flow|traffic|query|account|user|login).* script-path=https://raw.githubusercontent.com/elyndareth-max/box/main/Loon/Script/ChinaUnicom.js, requires-body=false, timeout=60, tag=联通组件 Cookie

[MITM]
hostname = m.client.10010.com
